{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardtable.dev/schemas/zone-render-profile.v1.schema.json",
  "title": "ZoneRenderProfile v1",
  "description": "Renderer-focused zone and layer policy contract (clipping, overflow, layering).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "layers",
    "zones"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "ctp.zone-render-profile.v1"
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clipMode": {
          "$ref": "#/$defs/clipMode"
        },
        "overflowBehavior": {
          "$ref": "#/$defs/overflowBehavior"
        },
        "clipPaddingPx": {
          "type": "number"
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/zone"
      }
    },
    "xExtensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "clipMode": {
      "type": "string",
      "enum": [
        "none",
        "rect",
        "rounded_rect",
        "path",
        "viewport"
      ]
    },
    "overflowBehavior": {
      "type": "string",
      "enum": [
        "visible",
        "clip",
        "hide_when_outside"
      ]
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layerId",
        "zIndex"
      ],
      "properties": {
        "layerId": {
          "type": "string",
          "minLength": 1
        },
        "zIndex": {
          "type": "integer"
        },
        "compositeMode": {
          "type": "string",
          "enum": [
            "normal",
            "multiply",
            "screen",
            "overlay",
            "additive"
          ],
          "default": "normal"
        },
        "xExtensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zoneId",
        "layerId"
      ],
      "properties": {
        "zoneId": {
          "type": "string",
          "minLength": 1
        },
        "layerId": {
          "type": "string",
          "minLength": 1
        },
        "clipMode": {
          "$ref": "#/$defs/clipMode"
        },
        "overflowBehavior": {
          "$ref": "#/$defs/overflowBehavior"
        },
        "clipPaddingPx": {
          "type": "number"
        },
        "clipRadiusPx": {
          "type": "number",
          "minimum": 0
        },
        "maskRef": {
          "type": "string",
          "minLength": 1
        },
        "coordinateSpace": {
          "type": "string",
          "enum": [
            "zone_local",
            "table",
            "viewport",
            "world"
          ],
          "default": "table"
        },
        "xExtensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "clipMode": {
                "const": "rounded_rect"
              }
            },
            "required": [
              "clipMode"
            ]
          },
          "then": {
            "required": [
              "clipRadiusPx"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "clipMode": {
                "const": "path"
              }
            },
            "required": [
              "clipMode"
            ]
          },
          "then": {
            "required": [
              "maskRef"
            ]
          }
        }
      ]
    }
  }
}
